/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: PREPROCESS {
        publishDir = [
          enabled: false
        ]
        cpus = 1
        memory = 48.GB
    }

    withName: CDR3_SIMILARITY {
        publishDir = [
          path: { params.asc_mode ? "${params.outdir}/cdr3_similarity/${meta.id}/${meta.group_id}" : "${params.outdir}/cdr3_similarity/${meta.id}" },
          mode: params.publish_dir_mode,
          saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        cpus = 1
        memory = 48.GB
    }
    withName: CDR3_SIMILARITY_FIRSTV {
        publishDir = [
          path: { params.asc_mode ? "${params.outdir}/cdr3_similarity_firstv/${meta.id}/${meta.group_id}" : "${params.outdir}/cdr3_similarity_firstv/${meta.id}" },
          mode: params.publish_dir_mode,
          saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        cpus = 1
        memory = 48.GB
        ext.args = "--first TRUE"
    }
    withName: MILO {
        publishDir = [
          path: { params.asc_mode ? "${params.outdir}/Milo/${meta.id}/${meta.group_id}" : "${params.outdir}/Milo/${meta.id}" },
          mode: params.publish_dir_mode,
          saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        cpus = 1
        memory = 40.GB
    }
    withName: BCRDIST {
        publishDir = [
          path: { params.asc_mode ? "${params.outdir}/BCRdist/${meta.id}/${meta.group_id}" : "${params.outdir}/BCRdist/${meta.id}" },
          mode: params.publish_dir_mode,
          saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        cpus = 4
        memory = 72.GB
    }
    withName: EVALUATE {
        publishDir = [
          path: { "${params.outdir}/${meta.tool_dir}/${meta.id}" },
          mode: params.publish_dir_mode,
          saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        cpus = 1
        memory = 48.GB
    }
    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
