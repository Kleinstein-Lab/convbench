/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: SPLIT_BY_ASC {
        publishDir = [
          enabled: false
        ]
        cpus = 1
        memory = 48.GB
    }

    withName: CDR3_SIMILARITY {
        publishDir = [
          path: { "${params.outdir}/cdr3_similarity/${meta.id}" },
          mode: params.publish_dir_mode,
          saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        cpus = 1
        memory = 48.GB
    }

    withName: CDR3_SIMILARITY_ASC {
        publishDir = [
          path: { "${params.outdir}/cdr3_similarity/${meta_id}/${asc_id}" },
          mode: params.publish_dir_mode,
          saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        cpus = 1
        memory = 48.GB
    }

    withName: MILO {
        publishDir = [
          path: { "${params.outdir}/Milo/${meta.id}" },
          mode: params.publish_dir_mode,
          saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        cpus = 1
        memory = 40.GB
    }

    withName: MILO_ASC {
        publishDir = [
          path: { "${params.outdir}/Milo/${meta_id}/${asc_id}" },
          mode: params.publish_dir_mode,
          saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        cpus = 1
        memory = 40.GB
    }

    withName: DASEQ {
        publishDir = [
          path: { "${params.outdir}/DA-seq/${meta.id}" },
          mode: params.publish_dir_mode,
          saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        cpus = 1
        memory = 36.GB
    }

    withName: DASEQ_ASC {
        publishDir = [
          path: { "${params.outdir}/DA-seq/${meta_id}/${asc_id}" },
          mode: params.publish_dir_mode,
          saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        cpus = 1
        memory = 36.GB
    }

    withName: BCRDIST {
        publishDir = [
          path: { "${params.outdir}/BCRdist/${meta.id}" },
          mode: params.publish_dir_mode,
          saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        cpus = 4
        memory = 72.GB
    }

    withName: BCRDIST_ASC {
        publishDir = [
          path: { "${params.outdir}/BCRdist/${meta_id}/${asc_id}" },
          mode: params.publish_dir_mode,
          saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        cpus = 4
        memory = 72.GB
    }

    withName: GET_ASC_AUROC {
        publishDir = [
          path: { "${params.outdir}/${tool_id}/${meta_id}" },
          mode: params.publish_dir_mode,
          saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
        cpus = 1
        memory = 48.GB
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
